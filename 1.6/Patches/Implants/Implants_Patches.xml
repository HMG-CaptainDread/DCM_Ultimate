	<!-- DLC -->
		<!-- ANOMALY -->
			<Operation Class="PatchOperationFindMod">
				<mods>
					<li>Anomaly</li>
				</mods>
				<match Class="PatchOperationSequence">
					<success>Normal</success>
					<operations>
						<!-- GHOUL IMPLANTS FOR HUMANS -->
							<!-- REMOVAL OF MUTANT PREREQUISITES -->
								<li Class="PatchOperationRemove">
									<xpath>
										Defs/RecipeDef[defName="InstallGhoulPlating"]/mutantPrerequisite	|
										Defs/RecipeDef[defName="InstallGhoulBarbs"]/mutantPrerequisite		|
										Defs/RecipeDef[defName="InstallAdrenalHeart"]/mutantPrerequisite	|
										Defs/RecipeDef[defName="InstallCorrosiveHeart"]/mutantPrerequisite	|
										Defs/RecipeDef[defName="InstallMetalbloodHeart"]/mutantPrerequisite
									</xpath>
								</li>
							<!-- PAIN OFFSETS -->
								<li Class="PatchOperationAdd">
									<xpath>
										Defs/HediffDef[defName="GhoulPlating"]/stages/li	|
										Defs/HediffDef[defName="GhoulBarbs"]/stages/li		|
										Defs/HediffDef[defName="AdrenalHeart"]/stages/li	|
										Defs/HediffDef[defName="CorrosiveHeart"]/stages/li	|
										Defs/HediffDef[defName="MetalbloodHeart"]/stages/li
									</xpath>
									<value>
										<painOffset>0.5</painOffset>
									</value>
								</li>
							<!-- BEAUTY OFFSETS -->
								<li Class="PatchOperationAdd">
									<xpath>
										Defs/HediffDef[defName="GhoulBarbs"]/stages/li/statOffsets		|
										Defs/HediffDef[defName="GhoulPlating"]/stages/li/statOffsets
									</xpath>
									<value>
										<PawnBeauty>-1</PawnBeauty>
									</value>
								</li>
							<!-- CORROSIVE HEART HEDIFF -->
								<li Class="PatchOperationAdd">
									<xpath>Defs/HediffDef[defName="CorrosiveHeart"]</xpath>
									<value>
										<stages>
											<li>
											</li>
										</stages>
									</value>
								</li>
