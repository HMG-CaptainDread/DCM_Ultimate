	<!-- TMM_InsectMealCooking_ -->



	<!-- BASES -->
		<RecipeDef Name="TMM_InsectMealCooking_MainBase" Abstract="True">
			<workSpeedStat>CookSpeed</workSpeedStat>
			<requiredGiverWorkType>Cooking</requiredGiverWorkType>
			<effectWorking>Cook</effectWorking>
			<soundWorking>Recipe_CookMeal</soundWorking>
			<allowMixingIngredients>true</allowMixingIngredients>
			<ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
			<workSkill>Cooking</workSkill>

			<recipeUsers>
				<li>ElectricStove</li>
				<li>FueledStove</li>
			</recipeUsers>

			<fixedIngredientFilter>
				<thingDefs>
					<li>Meat_Megaspider</li>
				</thingDefs>
				<categories>
					<li>PlantFoodRaw</li>
					<li>AnimalProductRaw</li>
				</categories>
				<specialFiltersToDisallow>
					<li>AllowPlantFood</li>
				</specialFiltersToDisallow>
			</fixedIngredientFilter>

			<defaultIngredientFilter>
				<thingDefs>
					<li>Meat_Megaspider</li>
				</thingDefs>
				<categories>
					<li>PlantFoodRaw</li>
					<li>AnimalProductRaw</li>
				</categories>
				<disallowedCategories>
					<li>EggsFertilized</li>
				</disallowedCategories>
				<disallowedThingDefs>
					<li>InsectJelly</li>
				</disallowedThingDefs>
			</defaultIngredientFilter>
		</RecipeDef>
	<!-- MEALS -->
		<!-- FINE -->
			<!-- BASE -->
				<RecipeDef ParentName="TMM_InsectMealCooking_MainBase" Name="TMM_InsectMealCooking_FineBase" Abstract="True">
					<jobString>Cooking fine meal.</jobString>

					<skillRequirements>
						<Cooking>6</Cooking>
					</skillRequirements>
				</RecipeDef>
			<!-- REGULAR -->
				<RecipeDef ParentName="TMM_InsectMealCooking_FineBase">
					<defName>TMM_InsectMealCooking_Fine</defName>
					<label>cook insect fine meal</label>
					<description>Cooks a somewhat complex insect meal from a combination of insect meat and organic ingredients.</description>

					<workAmount>480</workAmount>

					<ingredients>
						<li>
							<filter>
								<thingDefs>
									<li>Meat_Megaspider</li>
								</thingDefs>
							</filter>
							<count>0.25</count>
						</li>
						<li>
							<filter>
								<categories>
									<li>AnimalProductRaw</li>
									<li>PlantFoodRaw</li>
								</categories>
							</filter>
							<count>0.25</count>
						</li>
					</ingredients>

					<products>
						<TMM_InsectMeal_Fine>1</TMM_InsectMeal_Fine>
					</products>
				</RecipeDef>
