	<!-- TMM_CannibalMealCooking_ -->



	<!-- BASES -->
		<!-- MAIN BASE -->
			<RecipeDef Name="TMM_CannibalMealCooking_MainBase" Abstract="True">
				<workSpeedStat>CookSpeed</workSpeedStat>
				<requiredGiverWorkType>Cooking</requiredGiverWorkType>
				<effectWorking>Cook</effectWorking>
				<soundWorking>Recipe_CookMeal</soundWorking>
				<allowMixingIngredients>true</allowMixingIngredients>
				<ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
				<workSkill>Cooking</workSkill>

				<recipeUsers>
					<li>ElectricStove</li>
					<li>FueledStove</li>
				</recipeUsers>

				<fixedIngredientFilter>
					<thingDefs>
						<li>Meat_Human</li>
					</thingDefs>
					<categories>
						<li>PlantFoodRaw</li>
						<li>AnimalProductRaw</li>
					</categories>
					<specialFiltersToDisallow>
						<li>AllowPlantFood</li>
					</specialFiltersToDisallow>
				</fixedIngredientFilter>

				<defaultIngredientFilter>
					<thingDefs>
						<li>Meat_Human</li>
					</thingDefs>
					<categories>
						<li>PlantFoodRaw</li>
						<li>AnimalProductRaw</li>
					</categories>
					<disallowedCategories>
						<li>EggsFertilized</li>
					</disallowedCategories>
					<disallowedThingDefs>
						<li>InsectJelly</li>
					</disallowedThingDefs>
				</defaultIngredientFilter>
			</RecipeDef>
	<!-- MEALS -->
		<!-- FINE -->
			<!-- BASE -->
				<RecipeDef ParentName="TMM_CannibalMealCooking_MainBase" Name="TMM_CannibalMealCooking_FineBase" Abstract="True">
					<jobString>Cooking fine meal.</jobString>

					<skillRequirements>
						<Cooking>6</Cooking>
					</skillRequirements>
				</RecipeDef>
			<!-- REGULAR -->
				<RecipeDef ParentName="TMM_CannibalMealCooking_FineBase">
					<defName>TMM_CannibalMealCooking_Fine</defName>
					<label>cook cannibal fine meal</label>
					<description>Cooks a somewhat complex cannibal meal from a combination of human meat and organic ingredients.</description>

					<workAmount>480</workAmount>

					<ingredients>
						<li>
							<filter>
								<thingDefs>
									<li>Meat_Human</li>
								</thingDefs>
							</filter>
							<count>0.25</count>
						</li>
						<li>
							<filter>
								<categories>
									<li>AnimalProductRaw</li>
									<li>PlantFoodRaw</li>
								</categories>
							</filter>
							<count>0.25</count>
						</li>
					</ingredients>

					<products>
						<TMM_CannibalMeal_Fine>1</TMM_CannibalMeal_Fine>
					</products>
				</RecipeDef>
