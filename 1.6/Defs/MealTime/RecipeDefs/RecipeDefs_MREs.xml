	<!-- BASES -->
		<!-- MAIN -->
			<RecipeDef ParentName="CookMealBase" Name="TMM_MRECooking_Base" Abstract="True">
				<jobString>Making MREs.</jobString>

				<workSpeedStat>CookSpeed</workSpeedStat>
				<requiredGiverWorkType>Cooking</requiredGiverWorkType>
				<effectWorking>Cook</effectWorking>
				<soundWorking>Recipe_CookMeal</soundWorking>

				<allowMixingIngredients>true</allowMixingIngredients>

				<recipeUsers>
					<li>ElectricStove</li>
					<li>FueledStove</li>
				</recipeUsers>

				<skillRequirements>
					<Cooking>8</Cooking>
				</skillRequirements>

				<researchPrerequisites>
					<li>PackagedSurvivalMeal</li>
				</researchPrerequisites>
			</RecipeDef>
		<!-- CARNIVORE -->
			<!-- REGULAR -->
				<RecipeDef ParentName="TMM_MRECooking_Base" Name="TMM_MRECooking_CarnivoreRegularBase" Abstract="True">
