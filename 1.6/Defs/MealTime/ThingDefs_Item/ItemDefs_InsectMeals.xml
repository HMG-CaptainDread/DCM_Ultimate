<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- <></> -->
	<!-- TMM_InsectMeal_ -->



	<!-- BASES -->
		<!-- COOKED MEAL BASE -->
			<ThingDef ParentName="MealCooked" Name="TMM_InsectMeal_CookedMealBase" Abstract="True">
				<graphicData>
					<graphicClass>Graphic_StackCount</graphicClass>
				</graphicData>

				<ingestible>
					<ingestEffect>EatVegetarian</ingestEffect>
					<ingestSound>Meal_Eat</ingestSound>
				</ingestible>

				<tradeability>Sellable</tradeability>
			</ThingDef>
		<!-- MEAL BASE -->
			<ThingDef ParentName="MealBase" Name="TMM_InsectMeal_MealBase" Abstract="True">
				<graphicData>
					<graphicClass>Graphic_StackCount</graphicClass>
				</graphicData>

				<ingestible>
					<ingestEffect>EatVegetarian</ingestEffect>
					<optimalityOffsetHumanlikes>-5</optimalityOffsetHumanlikes>
					<optimalityOffsetFeedingAnimals>-10</optimalityOffsetFeedingAnimals>
					<ingestSound>Meal_Eat</ingestSound>
				</ingestible>

				<tradeability>Sellable</tradeability>
			</ThingDef>
		<!-- ORGANIC PRODUCT BASE -->
			<ThingDef ParentName="OrganicProductBase" Name="TMM_InsectMeal_OrganicProductBase" Abstract="True">
				<graphicData>
					<graphicClass>Graphic_StackCount</graphicClass>
				</graphicData>

				<thingCategories>
					<li>Foods</li>
				</thingCategories>

				<socialPropernessMatters>true</socialPropernessMatters>

				<ingestible>
					<ingestEffect>EatVegetarian</ingestEffect>
				</ingestible>

				<tradeability>Sellable</tradeability>
			</ThingDef>
	<!-- MEALS -->
		<!-- FINE MEAL -->
			<ThingDef ParentName="TMM_InsectMeal_CookedMealBase">
				<defName>TMM_InsectMeal_Fine</defName>
				<label>insect fine meal</label>
				<description>A complex dish assembled with care from insect meat and a wide selection of ingredients.</description>

				<graphicData>
					<texPath>Modules/MealTime/Things/Meals/InsectMeals/InsectFine</texPath>
				</graphicData>

				<statBases>
					<MarketValue>20</MarketValue>
					<WorkToMake>450</WorkToMake>
					<Nutrition>0.9</Nutrition>
				</statBases>

				<ingestible>
					<preferability>MealFine</preferability>
					<tasteThought>AteFineMeal</tasteThought>
				</ingestible>
			</ThingDef>
		<!-- LAVISH MEAL -->
			<ThingDef ParentName="TMM_InsectMeal_CookedMealBase">
				<defName>TMM_InsectMeal_Lavish</defName>
				<label>insect lavish meal</label>
				<description>A masterpiece of the insect culinary arts, this meal nourishes the body, mind, and soul.</description>

				<graphicData>
					<texPath>Modules/MealTime/Things/Meals/InsectMeals/InsectLavish</texPath>
				</graphicData>

				<statBases>
					<MarketValue>40</MarketValue>
					<WorkToMake>800</WorkToMake>
					<Nutrition>1</Nutrition>
				</statBases>

				<ingestible>
					<preferability>MealLavish</preferability>
					<tasteThought>AteLavishMeal</tasteThought>
				</ingestible>
			</ThingDef>
		<!-- PACKAGED SURVIVAL MEAL -->
			<ThingDef ParentName="TMM_InsectMeal_MealBase">
				<defName>TMM_InsectMeal_Survival</defName>
				<label>insect packaged survival meal</label>
				<description>A high-quality insect packaged meal, manufactured for use in survival situations.</description>

				<graphicData>
					<texPath>Modules/MealTime/Things/Meals/InsectMeals/InsectSurvivalMeal</texPath>
				</graphicData>

				<statBases>
					<DeteriorationRate>0.25</DeteriorationRate>
					<MarketValue>24</MarketValue>
					<Mass>0.3</Mass>
					<WorkToMake>450</WorkToMake>
					<Nutrition>0.9</Nutrition>
				</statBases>

				<ingestible>
					<preferability>MealSimple</preferability>
				</ingestible>
			</ThingDef>
		<!-- SIMPLE MEAL -->
			<ThingDef ParentName="TMM_InsectMeal_CookedMealBase">
				<defName>TMM_InsectMeal_Simple</defName>
				<label>insect simple meal</label>
				<description>A simple meal quickly cooked from insect meat and a few ingredients.</description>

				<graphicData>
					<texPath>Modules/MealTime/Things/Meals/InsectMeals/InsectSimple</texPath>
				</graphicData>

				<statBases>
					<MarketValue>15</MarketValue>
					<WorkToMake>300</WorkToMake>
					<Nutrition>0.8</Nutrition>
				</statBases>

				<ingestible>
					<preferability>MealSimple</preferability>
				</ingestible>
			</ThingDef>
	<!-- ORGANIC PRODUCTS -->
		<!-- KIBBLE -->
			<ThingDef ParentName="TMM_InsectMeal_OrganicProductBase">
				<defName>TMM_InsectMeal_Kibble</defName>
				<label>insect kibble</label>
				<description>Animal feed made from insect and plant sources. Humans can eat it, but they really, really don't like it.</description>

				<graphicData>
					<texPath>Modules/MealTime/Things/Meals/InsectMeals/InsectKibble</texPath>
				</graphicData>

				<statBases>
					<MarketValue>1.1</MarketValue>
					<Mass>0.015</Mass>
					<Nutrition>0.05</Nutrition>
					<FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
				</statBases>

				<ingestible>
					<foodType>Kibble</foodType>
					<preferability>RawBad</preferability>
					<tasteThought>AteKibble</tasteThought>
					<optimalityOffsetHumanlikes>-30</optimalityOffsetHumanlikes>
					<optimalityOffsetFeedingAnimals>15</optimalityOffsetFeedingAnimals>
					<ingestSound>RawVegetable_Eat</ingestSound>
				</ingestible>

				<comps>
					<li Class="CompProperties_Ingredients" />
				</comps>
			</ThingDef>
		<!-- PEMMICAN -->
			<ThingDef ParentName="TMM_InsectMeal_OrganicProductBase">
				<defName>TMM_InsectMeal_Pemmican</defName>
				<label>insect pemmican</label>
				<description>A preserved mashed mixture of insect fat and plant food. Tastes bland, but not offensive. It lasts a very long time without refrigeration.</description>

				<thingClass>ThingWithComps</thingClass>

				<graphicData>
					<texPath>Modules/MealTime/Things/Meals/InsectMeals/InsectPemmican</texPath>
				</graphicData>

				<statBases>
					<MarketValue>1.4</MarketValue>
					<Mass>0.018</Mass>
					<WorkToMake>700</WorkToMake>
					<DeteriorationRate>2</DeteriorationRate>
					<Nutrition>0.05</Nutrition>
				</statBases>

				<ingestible>
					<foodType>Meal</foodType>
					<preferability>MealSimple</preferability>
					<ingestSound>Meal_Eat</ingestSound>
					<optimalityOffsetHumanlikes>6</optimalityOffsetHumanlikes>
				</ingestible>

				<comps>
					<li Class="CompProperties_Rottable">
						<daysToRotStart>70</daysToRotStart>
						<rotDestroys>true</rotDestroys>
					</li>
					<li Class="CompProperties_Ingredients" />
					<li Class="CompProperties_FoodPoisonable" />
				</comps>
			</ThingDef>
	<!--  -->
</Defs>