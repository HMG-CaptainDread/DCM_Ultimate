	<!-- ARCHOTECH BRAIN -->
		<RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
			<defName>TMM_SurgeryInstall_ArchotechBrain</defName>
			<label>install archotech brain</label>
			<description>Install an archotech brain.</description>
			<descriptionHyperlinks>
				<ThingDef>TMM_Implant_ArchotechBrain</ThingDef>
				<HediffDef>TMM_Hediff_ArchotechBrain</HediffDef>
			</descriptionHyperlinks>
			<jobString>Installing archotech brain.</jobString>
			<workAmount>3000</workAmount>
			<deathOnFailedSurgeryChance>0.50</deathOnFailedSurgeryChance>
			<skillRequirements>
				<Medicine>12</Medicine>
			</skillRequirements>
			<ingredients>
				<li>
					<filter>
						<thingDefs>
							<li>TMM_Implant_ArchotechBrain</li>
						</thingDefs>
					</filter>
					<count>1</count>
				</li>
			</ingredients>
			<fixedIngredientFilter>
				<thingDefs>
					<li>TMM_Implant_ArchotechBrain</li>
				</thingDefs>
			</fixedIngredientFilter>
			<appliedOnFixedBodyParts>
				<li>Brain</li>
			</appliedOnFixedBodyParts>
			<addsHediff>TMM_Hediff_ArchotechBrain</addsHediff>
		</RecipeDef>
