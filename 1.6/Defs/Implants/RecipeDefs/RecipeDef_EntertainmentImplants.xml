	<!-- CATHARSIS PROTOCOL -->
		<!-- INSTALL -->
			<RecipeDef ParentName="SurgeryInstallImplantBase">
				<defName>TMM_SurgeryInstall_CatharsisImplant</defName>
				<label>install catharsis implant</label>
				<description>Install a catharsis implant.</description>
				<descriptionHyperlinks>
					<ThingDef>TMM_Implant_CatharsisImplant</ThingDef>
					<HediffDef>TMM_Hediff_CatharsisImplant</HediffDef>
				</descriptionHyperlinks>
				<jobString>Installing Catharsis implant.</jobString>
				<ingredients>
					<li>
						<filter>
							<thingDefs>
								<li>TMM_Implant_CatharsisImplant</li>
							</thingDefs>
						</filter>
						<count>1</count>
					</li>
				</ingredients>
				<fixedIngredientFilter>
					<thingDefs>
						<li>TMM_Implant_CatharsisImplant</li>
					</thingDefs>
				</fixedIngredientFilter>
				<appliedOnFixedBodyParts>
					<li>Brain</li>
				</appliedOnFixedBodyParts>
				<addsHediff>TMM_Hediff_CatharsisImplant</addsHediff>
				<surgerySuccessChanceFactor>0.7</surgerySuccessChanceFactor>
				<skillRequirements>
					<Medicine>15</Medicine>
				</skillRequirements>
			</RecipeDef>
		<!-- REMOVE -->
			<RecipeDef ParentName="SurgeryRemoveImplantBase">
				<defName>TMM_SurgeryRemove_CatharsisImplant</defName>
				<label>remove catharsis implant</label>
				<description>Remove catharsis implant.</description>
				<descriptionHyperlinks>
					<ThingDef>TMM_Implant_CatharsisImplant</ThingDef>
					<HediffDef>TMM_Hediff_CatharsisImplant</HediffDef>
				</descriptionHyperlinks>
				<jobString>Removing catharsis implant.</jobString>
				<removesHediff>TMM_Hediff_CatharsisImplant</removesHediff>
			</RecipeDef>
