			<stages>
				<li>
					<partEfficiencyOffset>0.25</partEfficiencyOffset>
					<capMods>
						<li>
							<capacity>Moving</capacity>
							<postFactor>1.10</postFactor>
						</li>
					</capMods>
				</li>
			</stages>
			<spawnThingOnRemoved>TMM_Implant_ArchotechCerebralTurbocharger</spawnThingOnRemoved>
		</HediffDef>
