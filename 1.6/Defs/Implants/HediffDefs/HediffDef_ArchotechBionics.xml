			<spawnThingOnRemoved>TMM_Implant_ArchotechWarriorEye</spawnThingOnRemoved>
			<renderNodeProperties>
				<li Class="PawnRenderNodeProperties_Eye">
					<workerClass>PawnRenderNodeWorker_HediffEye</workerClass>
					<texPath>Things/Pawn/Wounds/ArchotechEye</texPath>
					<parentTagDef>Head</parentTagDef>
					<drawSize>0.15</drawSize>
					<drawData>
						<defaultData>
							<layer>56</layer>
							<offset>(0, 0, -0.25)</offset>
						</defaultData>
						<dataWest>
							<flip>true</flip>
						</dataWest>
					</drawData>
				</li>
			</renderNodeProperties>
		</HediffDef>
	<!-- WARRIOR LEG -->
