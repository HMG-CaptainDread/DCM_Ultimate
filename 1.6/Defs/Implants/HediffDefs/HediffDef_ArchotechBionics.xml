	<!-- CEREBRAL ENHANCER -->
		<HediffDef ParentName="ImplantHediffBase">
			<defName>TMM_Hediff_ArchotechCerebralEnhancer</defName>
			<label>archotech cerebral enhancer</label>
			<labelNoun>an archotech cerebral enhancer</labelNoun>
			<description>An installed archotech cerebral enhancer implant.</description>
			<descriptionHyperlinks>
				<ThingDef>TMM_Implant_ArchotechCerebralEnhancer</ThingDef>
			</descriptionHyperlinks>
			<stages>
				<li>
					<makeImmuneTo>
						<li>Dementia</li>
						<li>Alzheimers</li>
						<li>TraumaSavant</li>
						<li>SleepingSickness</li>
						<li>CrumblingMind</li>
					</makeImmuneTo>
					<painFactor>0.80</painFactor>
					<capMods>
						<li>
							<capacity>Consciousness</capacity>
							<offset>0.20</offset>
						</li>
					</capMods>
					<partEfficiencyOffset>0.3</partEfficiencyOffset>
					<statOffsets>
						<AimingDelayFactor>-0.25</AimingDelayFactor>
						<MeleeDodgeChance>5</MeleeDodgeChance>
						<GlobalLearningFactor>0.3</GlobalLearningFactor>
						<ResearchSpeed>0.3</ResearchSpeed>
						<GeneralLaborSpeed>0.2</GeneralLaborSpeed>
					</statOffsets>
				</li>
			</stages>
			<spawnThingOnRemoved>TMM_Implant_ArchotechCerebralEnhancer</spawnThingOnRemoved>
		</HediffDef>
	<!-- CEREBRAL TURBOCHARGER -->
