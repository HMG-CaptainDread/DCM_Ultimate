			<!-- ECONO-SAVE PLINK-PROTECT™ -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_PlinkProtect</defName>
					<label>Econo-Save Plink-Protect™</label>
					<labelNoun>a Plink-Protect™ implant</labelNoun>
					<description>Increases base body armour by 5% by making the body denser. Causes organs to harden slightly in response to physical trauma.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_PlinkProtect</ThingDef>
					</descriptionHyperlinks>
					<stages>
						<li>
							<statOffsets>
								<ArmorRating_Sharp>0.05</ArmorRating_Sharp>
								<ArmorRating_Blunt>0.05</ArmorRating_Blunt>
							</statOffsets>
						</li>
					</stages>
				</HediffDef>
			<!-- JUNKER'S LATTICE -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_JunkersLattice</defName>
					<label>Junker's Lattice</label>
					<labelNoun>a Junker's Lattice implant</labelNoun>
					<description>A poorly manufactured lattice implant. While providing some protection, it causes constant discomfort and impairs body functions.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_JunkersLattice</ThingDef>
					</descriptionHyperlinks>
					<spawnThingOnRemoved>TMM_Implant_JunkersLattice</spawnThingOnRemoved>
