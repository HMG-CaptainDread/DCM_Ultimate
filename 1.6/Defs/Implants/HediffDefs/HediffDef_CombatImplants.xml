		<!-- DAMAGE RESISTANCE -->
			<!-- MERCENARY -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_MercenaryResistanceImplant</defName>
					<label>mercenary resistance implant</label>
					<labelNoun>a mercenary resistance implant</labelNoun>
					<description>This implant extends a weak psionic field throughout the entire body, increasing its density and resilience to damage. The design was created by reverse-engineering an extremely powerful Vacuous-grade implant and copying the psionic field. The materials aren't sufficient for the full field, but this implant is valuable nonetheless.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_MercenaryResistanceImplant</ThingDef>
					</descriptionHyperlinks>
					<spawnThingOnRemoved>TMM_Implant_MercenaryResistanceImplant</spawnThingOnRemoved>
					<stages>
						<li>
							<statFactors>
								<IncomingDamageFactor>0.75</IncomingDamageFactor>
							</statFactors>
						</li>
					</stages>
				</HediffDef>
			<!-- PAIN -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_PainResistanceCoreImplant</defName>
					<label>pain resistance-core implant</label>
					<labelNoun>a pain resistance-core implant</labelNoun>
					<description>There is no strength without suffering. This implant can be installed on all body parts. It is cheap and abundant. It requires no medical skill. But it is incredibly difficult to install.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_PainResistanceCoreImplant</ThingDef>
					</descriptionHyperlinks>
					<spawnThingOnRemoved>TMM_Implant_PainResistanceCoreImplant</spawnThingOnRemoved>
					<hediffClass>Hediff_Level</hediffClass>
					<maxSeverity>4</maxSeverity>
					<stages>
						<li>
							<minSeverity>0</minSeverity>
							<statFactors>
								<IncomingDamageFactor>1</IncomingDamageFactor>
							</statFactors>
						</li>
						<li>
							<minSeverity>1</minSeverity>
							<statFactors>
								<IncomingDamageFactor>0.95</IncomingDamageFactor>
							</statFactors>
						</li>
						<li>
							<minSeverity>2</minSeverity>
							<statFactors>
								<IncomingDamageFactor>0.90</IncomingDamageFactor>
							</statFactors>
						</li>
						<li>
							<minSeverity>3</minSeverity>
							<statFactors>
								<IncomingDamageFactor>0.85</IncomingDamageFactor>
							</statFactors>
						</li>
					</stages>
					<injuryProps>
						<canMerge>true</canMerge>
					</injuryProps>
				</HediffDef>
		<!-- FOCUS CHIP -->
			<HediffDef ParentName="ImplantHediffBase">
				<defName>TMM_Hediff_MercenaryFocusImplant</defName>
				<label>mercenary focus implant</label>
				<labelNoun>a mercenary focus implant</labelNoun>
				<description>This implant reduces the need for sleep and recreation, allowing a soldier to focus purely on the battle in front of them.</description>
				<descriptionHyperlinks>
					<ThingDef>TMM_Implant_MercenaryFocusImplant</ThingDef>
				</descriptionHyperlinks>
				<spawnThingOnRemoved>TMM_Implant_MercenaryFocusImplant</spawnThingOnRemoved>
