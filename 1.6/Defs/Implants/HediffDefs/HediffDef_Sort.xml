	<!-- BASES -->

	<!-- ROYAL EYE -->
		<HediffDef ParentName="AddedBodyPartBase">
			<defName>GS_RoyalEye</defName>
			<label>Royal eye</label>
			<labelNoun>a royal eye</labelNoun>
			<description>An installed royal eye.</description>
			<descriptionHyperlinks><ThingDef>GS_RoyalEye</ThingDef></descriptionHyperlinks>
			<spawnThingOnRemoved>GS_RoyalEye</spawnThingOnRemoved>
			<woundAnchorRange>0</woundAnchorRange>
			<displayWound>true</displayWound>
			<addedPartProps>
				<solid>true</solid>
				<partEfficiency>1.4</partEfficiency>
				<betterThanNatural>false</betterThanNatural>
			</addedPartProps>
			<stages>
				<li>
					<statOffsets>
						<PawnBeauty>1</PawnBeauty>
						<SocialImpact>0.35</SocialImpact>
					</statOffsets>
				</li>
			</stages>
			<renderNodeProperties>
				<li Class="PawnRenderNodeProperties_Eye">
					<workerClass>PawnRenderNodeWorker_HediffEye</workerClass>
					<texPath>Things/Pawn/Wounds/RoyalEye</texPath>
					<parentTagDef>Head</parentTagDef>
					<drawSize>0.15</drawSize>
					<drawData>
						<defaultData>
							<layer>70</layer>
							<offset>(-0.01, 0, -0.23)</offset>
						</defaultData>
						<dataWest>
							<flip>true</flip>
						</dataWest>
					</drawData>
				</li>
			</renderNodeProperties>
		</HediffDef>
	<!-- LIGHT REGENERATION -->
		<HediffDef>
			<defName>LightRegeneration</defName>
			<label>regeneration</label>
			<description>This creature is experiencing an impossibly fast rate of regeneration supported by a distant archotechnological engine. They will heal nearly any wound in a short time.</description>
			<isBad>false</isBad>
			<stages>
				<li>
					<minSeverity>0</minSeverity>
					<label>weakened</label>
					<regeneration>50</regeneration>
				</li>
			</stages>
		</HediffDef>
	<!--  -->
</Defs>