	<!-- IMPLANTS -->
		<!-- WORK IMPLANTS -->
			<!-- TOM NOOK HARVEST -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_TomNookHarvestImplant</defName>
					<label>Tom Nook Harvest implant</label>
					<labelNoun>a Tom Nook Harvest implant</labelNoun>
					<description>Another coveted implant bestowed on the world by the Vacuous and then downgraded to be feasible for mass manufacture. This implant dramatically improves a user's capability to strip animal flesh and leather off the bones, allowing the user to get as much meat as possible from animals.\nUsed by workers in the Vacuous' industrial-grade thrumbo farms.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_TomNookHarvestImplant</ThingDef>
					</descriptionHyperlinks>
					<spawnThingOnRemoved>TMM_Implant_TomNookHarvestImplant</spawnThingOnRemoved>
					<stages>
						<li>
							<statOffsets>
								<AnimalGatherYield>1.0</AnimalGatherYield>
								<AnimalGatherSpeed>1.0</AnimalGatherSpeed>
							</statOffsets>
						</li>
					</stages>
				</HediffDef>
			<!-- LABOURER'S -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_LabourersImplant</defName>
					<label>labourer's implant</label>
					<labelNoun>a labourer's implant</labelNoun>
					<description>Another coveted implant bestowed on the world by the Vacuous and then downgraded to be feasible for mass manufacture. This implant dramatically improves a user's capability to perform random labor. Great for generalists and janitors.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_LabourersImplant</ThingDef>
					</descriptionHyperlinks>
					<spawnThingOnRemoved>TMM_Implant_LabourersImplant</spawnThingOnRemoved>
					<stages>
						<li>
							<statOffsets>
								<CleaningSpeed>2.0</CleaningSpeed>
								<SmeltingSpeed>3.0</SmeltingSpeed>
								<ReadingSpeed>1.5</ReadingSpeed>
								<WorkSpeedGlobal>0.5</WorkSpeedGlobal>
							</statOffsets>
							<statFactors>
								<JoyFallRateFactor>0.5</JoyFallRateFactor>
							</statFactors>
						</li>
					</stages>
				</HediffDef>
			<!-- MERCENARY CONVENIENCE -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_MercenaryConvenienceImplant</defName>
					<label>mercenary convenience implant</label>
					<labelNoun>a mercenary convenience implant</labelNoun>
					<description>This all-in-one work implant allows mercenaries to improve their cooking, cleaning, and general work speed while in camp. It helps avoid food poisoning and general wastes of time and resources. Good for after a battle.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_MercenaryConvenienceImplant</ThingDef>
					</descriptionHyperlinks>
					<spawnThingOnRemoved>TMM_Implant_MercenaryConvenienceImplant</spawnThingOnRemoved>
					<stages>
						<li>
							<statOffsets>
								<WorkSpeedGlobal>0.05</WorkSpeedGlobal>
								<SmeltingSpeed>0.25</SmeltingSpeed>
								<CleaningSpeed>0.50</CleaningSpeed>
								<ResearchSpeed>0.15</ResearchSpeed>
								<MoveSpeed>0.05</MoveSpeed>
								<ConstructSuccessChance>0.50</ConstructSuccessChance>
								<FixBrokenDownBuildingSuccessChance>0.50</FixBrokenDownBuildingSuccessChance>
								<MedicalTendQuality>0.10</MedicalTendQuality>
								<FoodPoisonChance>-0.8</FoodPoisonChance>
							</statOffsets>
						</li>
					</stages>
				</HediffDef>
			<!-- TRADER CHIP -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_TraderChipImplant</defName>
					<label>trader chip implant</label>
					<labelNoun>a trader chip implant</labelNoun>
					<description>Another coveted implant bestowed on the world by the Vacuous and then downgraded to be feasible for mass manufacture. This implant dramatically improves trading knowledge. Somewhere in its code is the equation, and solution, for capitalism.\nEarly recipients were able to make fortunes off the stock market before they were eliminated and their wealth taken by mercenaries using combat implants.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_TraderChipImplant</ThingDef>
					</descriptionHyperlinks>
					<spawnThingOnRemoved>TMM_Implant_TraderChipImplant</spawnThingOnRemoved>
					<stages>
						<li>
							<statOffsets>
								<TradePriceImprovement>0.15</TradePriceImprovement>
							</statOffsets>
						</li>
					</stages>
