<Defs>
	<!-- <></> -->
	<!-- TMM_Hediff_ -->
	<!-- TMM_SurgeryInstall_ -->
	<!-- TMM_SurgeryRemove_ -->
	<!-- TMM_Implant_ -->



	<!-- BASE -->

	<!-- IMPLANTS -->
		<!-- DESCARIFICATION -->
			<!-- RAPID -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_RapidDescarificationImplant</defName>
					<label>rapid descarification implant</label>
					<labelNoun>a rapid descarification implant</labelNoun>
					<description>Made from a custom distillation of luciferium. This one has been upgraded for Hedonic Elites, making it much more powerful. It will heal any scars and even regrow limbs. This will heal scars every day.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_RapidDescarificationImplant</ThingDef>
					</descriptionHyperlinks>
					<comps>
						<li Class="HediffCompProperties_HealPermanentWounds" />
					</comps>
					<stages>
						<li>
							<statOffsets>
							</statOffsets>
							<naturalHealingFactor>3.0</naturalHealingFactor>
						</li>
					</stages>
					<spawnThingOnRemoved>TMM_Implant_RapidDescarificationImplant</spawnThingOnRemoved>
				</HediffDef>
			<!-- REGULAR -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_DescarificationImplant</defName>
					<label>descarification implant</label>
					<labelNoun>a descarification implant</labelNoun>
					<description>Made from a custom distillation of luciferium. It's not especially powerful, but it will heal any scars. This will heal scars every 2-3 days.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_DescarificationImplant</ThingDef>
					</descriptionHyperlinks>
					<comps>
						<li Class="HediffCompProperties_HealPermanentWounds" />
					</comps>
					<stages>
						<li>
							<statOffsets>
							</statOffsets>
							<naturalHealingFactor>2.0</naturalHealingFactor>
						</li>
					</stages>
					<spawnThingOnRemoved>TMM_Implant_DescarificationImplant</spawnThingOnRemoved>
				</HediffDef>
		<!-- HEALING -->
			<!-- ECONOSAVE -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_EconoSaveFeelGoodImplant</defName>
					<label>Econo-Save FeelGood™</label>
					<labelNoun>a Econo-Save FeelGood™</labelNoun>
					<description>An Econo-Save FeelGood™ found scattered across battlefields and ruins, reused endlessly across the universe.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_EconoSaveFeelGoodImplant</ThingDef>
					</descriptionHyperlinks>
					<stages>
						<li>
							<statFactors>
								<InjuryHealingFactor>1.10</InjuryHealingFactor>
							</statFactors>
						</li>
					</stages>
					<maxSeverity>4</maxSeverity>
				</HediffDef>
			<!-- JUNK -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_JunkersHealingImplant</defName>
					<label>junkers healing implant</label>
					<labelNoun>a junkers healing implant</labelNoun>
					<description>This implant was designed to accelerate healing from injuries, but it also causes itchiness and slows the immune system.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_JunkersHealingImplant</ThingDef>
					</descriptionHyperlinks>
					<spawnThingOnRemoved>TMM_Implant_JunkersHealingImplant</spawnThingOnRemoved>
					<stages>
						<li>
							<painOffset>0.03</painOffset>
							<statOffsets>
								<ImmunityGainSpeed>-0.40</ImmunityGainSpeed>
							</statOffsets>
							<statFactors>
								<InjuryHealingFactor>1.25</InjuryHealingFactor>
							</statFactors>
						</li>
					</stages>
				</HediffDef>
			<!-- MERCENARY -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_MercenaryHealingImplant</defName>
					<label>mercenary healing implant</label>
					<labelNoun>a mercenary healing implant</labelNoun>
					<description>This implant was designed to allow mercenaries to heal much faster than they otherwise would so that they could re-enter combat.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_MercenaryHealingImplant</ThingDef>
					</descriptionHyperlinks>
					<spawnThingOnRemoved>TMM_Implant_MercenaryHealingImplant</spawnThingOnRemoved>
					<stages>
						<li>
							<statOffsets>
								<InjuryHealingFactor>0.50</InjuryHealingFactor>
							</statOffsets>
						</li>
					</stages>
				</HediffDef>
			<!-- PAIN -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_PainHealingCoreImplant</defName>
					<label>pain healing-core implant</label>
					<labelNoun>a pain healing-core implant</labelNoun>
					<description>There is no strength without suffering. This implant can be installed on all body parts. It is cheap and abundant. It requires no medical skill. But it is incredibly difficult to install.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_PainHealingCoreImplant</ThingDef>
					</descriptionHyperlinks>
					<spawnThingOnRemoved>TMM_Implant_PainHealingCoreImplant</spawnThingOnRemoved>
					<stages>
						<li>
							<statFactors>
								<InjuryHealingFactor>1.15</InjuryHealingFactor>
							</statFactors>
						</li>
					</stages>
				</HediffDef>
			<!-- PROTOTYPE -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_PrototypeFiltrumiteImplant</defName>
					<label>prototype filtrumite implant</label>
					<labelNoun>a prototype filtrumite implant</labelNoun>
					<description>An incredibly powerful healing implant found in an escaped mutated monster that destroyed a town. Everyone in the town was eaten, but the monster had still starved to death in the street.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_PrototypeFiltrumiteImplant</ThingDef>
					</descriptionHyperlinks>
					<spawnThingOnRemoved>TMM_Implant_PrototypeFiltrumiteImplant</spawnThingOnRemoved>
					<stages>
						<li>
							<hungerRateFactor>0.75</hungerRateFactor>
							<statFactors>
								<InjuryHealingFactor>100.0</InjuryHealingFactor>
							</statFactors>
							<capMods>
								<li>
									<capacity>BloodFiltration</capacity>
									<offset>1.5</offset>
								</li>
							</capMods>
						</li>
					</stages>
					<comps>
						<li Class="EBF.Hediffs.HediffCompProperties_MaxHPAdjust" MayRequire="V1024.EBFramework">
							<linearAdjustment>150</linearAdjustment>
						</li>
					</comps>
				</HediffDef>
		<!-- HP BOOSTING -->
			<!-- ECONOSAVE -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_EconoSaveBoosterPackImplant</defName>
					<label>Econo-Save Booster Pack</label>
					<labelNoun>an Econo-Save Booster Pack</labelNoun>
					<description>Injects additional energy into the body, allowing the user to survive more intense injuries. Only works with the Elite Bionics Framework mod installed.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_EconoSaveBoosterPackImplant</ThingDef>
					</descriptionHyperlinks>
					<comps>
						<li Class="EBF.Hediffs.HediffCompProperties_MaxHPAdjust" MayRequire="V1024.EBFramework">
							<linearAdjustment>5</linearAdjustment>
						</li>
					</comps>
				</HediffDef>
		<!-- IMMUNITY -->
			<!-- JUNK -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_JunkersImmunityImplant</defName>
					<label>junkers immunity implant</label>
					<labelNoun>a junkers immunity implant</labelNoun>
					<description>This implant was designed to accelerate healing from disease, but the immune cells it releases cause the body to heal slower.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_JunkersImmunityImplant</ThingDef>
					</descriptionHyperlinks>
					<spawnThingOnRemoved>TMM_Implant_JunkersImmunityImplant</spawnThingOnRemoved>
					<stages>
						<li>
							<statOffsets>
								<ImmunityGainSpeed>0.40</ImmunityGainSpeed>
							</statOffsets>
							<statFactors>
								<InjuryHealingFactor>0.50</InjuryHealingFactor>
							</statFactors>
						</li>
					</stages>
				</HediffDef>
			<!-- MERCENARY -->
				<HediffDef ParentName="ImplantHediffBase">
					<defName>TMM_Hediff_MercenaryImmunityImplant</defName>
					<label>mercenary immunity implant</label>
					<labelNoun>a mercenary immunity implant</labelNoun>
					<description>This implant was designed to allow mercenaries to ignore their diseases with minimal treatment on the battlefield.</description>
					<descriptionHyperlinks>
						<ThingDef>TMM_Implant_MercenaryImmunityImplant</ThingDef>
					</descriptionHyperlinks>
					<spawnThingOnRemoved>TMM_Implant_MercenaryImmunityImplant</spawnThingOnRemoved>
					<stages>
						<li>
							<statOffsets>
								<ImmunityGainSpeed>0.40</ImmunityGainSpeed>
							</statOffsets>
						</li>
					</stages>
				</HediffDef>
</Defs>