						<RecipeDef>TMM_SurgeryInstall_DescarificationImplant</RecipeDef>
					</descriptionHyperlinks>
					<statBases>
						<MarketValue>5000</MarketValue>
					</statBases>
					<costList>
						<Plasteel>10</Plasteel>
						<ComponentSpacer>3</ComponentSpacer>
					</costList>
				</ThingDef>
