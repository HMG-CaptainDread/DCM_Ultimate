			<!-- RAPID -->
				<ThingDef ParentName="TMM_Implant_HealthPartHoldoverBase">
					<defName>TMM_Implant_RapidDescarificationImplant</defName>
					<label>rapid descarification implant</label>
					<description>Made from a custom distillation of luciferium. This one has been upgraded for Hedonic Elites, making it much more powerful. It will heal any scars and even regrow limbs. This will heal scars every day.</description>
					<descriptionHyperlinks>
						<RecipeDef>TMM_SurgeryInstall_RapidDescarificationImplant</RecipeDef>
					</descriptionHyperlinks>
					<statBases>
						<MarketValue>25000</MarketValue>
					</statBases>
					<costList>
						<Plasteel>10</Plasteel>
						<ComponentSpacer>3</ComponentSpacer>
					</costList>
				</ThingDef>
			<!-- REGULAR -->
