	<!-- BASES -->

	<!-- ARCHOTECH BRAIN -->
		<ThingDef ParentName="BodyPartArchotechBase">
			<defName>TMM_Implant_ArchotechBrain</defName>
			<label>archotech brain</label>
			<description>An advanced artificial brain built by an archotech. It looks and feels like natural flesh, but it's harder to damage than plasteel. Even if it is harmed, it repairs itself over time. Its internal workings are a mystery to all human minds.</description>
			<descriptionHyperlinks>
				<RecipeDef>TMM_SurgeryInstall_ArchotechBrain</RecipeDef>
			</descriptionHyperlinks>
			<statBases>
				<MarketValue>5600</MarketValue>
				<Mass>1</Mass>
			</statBases>
			<thingSetMakerTags>
				<li>RewardStandardHighFreq</li>
			</thingSetMakerTags>
		</ThingDef>
	<!-- BIONIC BRAIN -->
		<ThingDef ParentName="BodyPartBionicBase">
			<defName>TMM_Implant_BionicBrain</defName>
			<label>bionic brain</label>
			<description>An advanced artificial brain. It has synthetic muscle fibres and a lattice-dust healing system. It is better than a biological brain in almost every way.</description>
			<descriptionHyperlinks>
				<RecipeDef>TMM_SurgeryInstall_BionicBrain</RecipeDef>
			</descriptionHyperlinks>
			<costList>
				<AIPersonaCore>1</AIPersonaCore>
				<ComponentSpacer>10</ComponentSpacer>
				<Plasteel>50</Plasteel>
				<Gold>3</Gold>
			</costList>
			<thingSetMakerTags><li>RewardStandardMidFreq</li></thingSetMakerTags>
			<statBases>
				<MarketValue>2400</MarketValue>
				<WorkToMake>25000</WorkToMake>
				<Mass>1</Mass>
			</statBases>
		</ThingDef>
	<!-- SYNTHETIC BRAIN -->
		<ThingDef ParentName="BodyPartProstheticMakeableBase">
			<defName>TMM_Implant_SyntheticBrain</defName>
			<label>synthetic brain</label>
			<description>A synthetic brain. It's not as efficient as the real thing but it's better than not having one at all.</description>
			<descriptionHyperlinks>
				<RecipeDef>TMM_SurgeryInstall_SyntheticBrain</RecipeDef>
			</descriptionHyperlinks>
			<costList>
				<ComponentSpacer>2</ComponentSpacer>
				<Plasteel>30</Plasteel>
				<Gold>1</Gold>
			</costList>
			<statBases>
				<MarketValue>1200</MarketValue>
				<WorkToMake>12500</WorkToMake>
				<Mass>1</Mass>
			</statBases>
			<techHediffsTags>
				<li>Simple</li>
			</techHediffsTags>
		</ThingDef>
