	<!-- HEDONIC ELITE -->
		<ThingDef ParentName="TMM_Implant_EntertainmentPartHoldoverBase">
			<defName>TMM_Implant_HedonicEliteImplant</defName>
			<label>hedonic elite implant</label>
			<description>This implant is given to the highest government officials as a way of rewarding them for surpassing quota. It is so strong that it completely overpowers any remorse they may have for selling entire nations into Vacuous experimentation and slavery.\n\nNon-Vacuous who have this implant are known as 'Hedonic Elite' for the rapturous joy they experience while this implant is active… and for the terrible lack of empathy they show towards anyone else.</description>
			<descriptionHyperlinks>
				<RecipeDef>TMM_SurgeryInstall_HedonicEliteImplant</RecipeDef>
			</descriptionHyperlinks>
			<statBases>
				<MarketValue>50000</MarketValue>
			</statBases>
			<costList>
				<Plasteel>10</Plasteel>
				<ComponentSpacer>3</ComponentSpacer>
			</costList>
		</ThingDef>
	<!-- PLEASURE CHIP -->
		<ThingDef ParentName="TMM_Implant_EntertainmentPartHoldoverBase">
			<defName>TMM_Implant_PleasureChipImplant</defName>
			<label>pleasure chip implant</label>
			<description>Artificial happiness, now created by a tiny custom brain organ housed inside the implant. It is part of the Hedonism series of implants developed by the Vacuous and awarded to those who meet their subject quotas.</description>
			<descriptionHyperlinks>
				<RecipeDef>TMM_SurgeryInstall_PleasureChipImplant</RecipeDef>
			</descriptionHyperlinks>
			<statBases>
				<MarketValue>8000</MarketValue>
			</statBases>
			<costList>
