			<AbilityDef ParentName="RoleAuraBuffBase">
				<defName>TMM_Ability_MilitarismCombatFocus</defName>
				<label>combat focus</label>
				<description>The caster remembers their training. This improves their combat stats and defence. The focus will last for 3 hours.</description>
				<iconPath>Modules/Ideologies/UI/AbilityIcons/MilitarismCombatFocus</iconPath>
				<warmupMoteSocialSymbol>Modules/Ideologies/UI/AbilityIcons/MilitarismCombatFocus</warmupMoteSocialSymbol>

				<statBases>
					<Ability_Duration>126</Ability_Duration>
					<Ability_EffectRadius>0</Ability_EffectRadius>
				</statBases>

				<verbProperties>
					<range>0</range>
				</verbProperties>

				<comps>
					<li Class="CompProperties_AbilityGiveHediff">
						<compClass>CompAbilityEffect_GiveHediff</compClass>
						<hediffDef>TMM_Hediff_MilitarismCombatFocus</hediffDef>
						<onlyApplyToSelf>True</onlyApplyToSelf>
						<replaceExisting>true</replaceExisting>
					</li>
				</comps>
			</AbilityDef>
		<!-- MEDICAL FOCUS -->
