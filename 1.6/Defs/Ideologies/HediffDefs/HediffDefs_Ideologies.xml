<?xml version="1.0" encoding="UTF-8"?>
<Defs>
	<!-- <></> -->
	<!-- TMM_Hediff_ -->



	<!-- MILITARISM -->
		<!-- COMBAT FOCUS -->
			<HediffDef ParentName="RoleStatBuff">
				<defName>TMM_Hediff_MilitarismCombatFocus</defName>
				<label>combat focus</label>
				<description>Legs spread wide, teeth clenched, just breathe, there is nothing else here, but bullets and blood.</description>
				<hediffClass>HediffWithComps</hediffClass>

				<stages>
					<li>
						<statOffsets>
							<MeleeHitChance>3</MeleeHitChance>
							<MeleeDodgeChance>3</MeleeDodgeChance>
							<ShootingAccuracyPawn>2</ShootingAccuracyPawn>
							<AimingDelayFactor>-0.2</AimingDelayFactor>
						</statOffsets>
						<painFactor>0.6</painFactor>
					</li>
				</stages>

				<comps>
					<li Class="HediffCompProperties_Disappears">
						<showRemainingTime>True</showRemainingTime>
					</li>
					<li Class="HediffCompProperties_DisappearsOnDeath"/>
				</comps>

				<isBad>false</isBad>
			</HediffDef>
		<!-- MEDICAL FOCUS -->
			<HediffDef ParentName="RoleStatBuff">
				<defName>TMM_Hediff_MilitarismMedicalFocus</defName>
				<label>medical focus</label>
				<description>Legs spread wide, teeth clenched, remember, the only person who can save them is you.</description>
				<hediffClass>HediffWithComps</hediffClass>

				<stages>
					<li>
						<statOffsets>
							<MedicalTendSpeed>2</MedicalTendSpeed>
							<MeleeHitChance>1</MeleeHitChance>
							<MeleeDodgeChance>1</MeleeDodgeChance>
							<ShootingAccuracyPawn>1</ShootingAccuracyPawn>
							<AimingDelayFactor>-0.1</AimingDelayFactor>
						</statOffsets>
						<painFactor>0.7</painFactor>
					</li>
				</stages>

				<comps>
					<li Class="HediffCompProperties_Disappears">
						<showRemainingTime>True</showRemainingTime>
					</li>
					<li Class="HediffCompProperties_DisappearsOnDeath"/>
				</comps>

				<isBad>false</isBad>
			</HediffDef>
	<!--  -->
</Defs>