	<!-- ROO'S -->
		<!-- DREADS ONLY -->
			<GeneDef>
				<defName>Hair_DreadlocksOnly</defName>
				<label>dreadlocks</label>
				<labelShortAdj>dreadlocks</labelShortAdj>
				<description>Carriers of this gene have dreadlocks.</description>
				<iconPath>UI/GeneIcons/DreadlocksOnly</iconPath>
				<displayOrderInCategory>59</displayOrderInCategory>
				<hairTagFilter>
					<whitelist>true</whitelist>
					<tags>
						<li>Dreadlocks</li>
					</tags>
				</hairTagFilter>
				<symbolPack>
					<prefixSymbols>
						<li><symbol>dread</symbol></li>
						<li><symbol>loc</symbol></li>
						<li><symbol>coil</symbol></li>
						<li><symbol>braid</symbol></li>
					</prefixSymbols>
					<suffixSymbols>
						<li><symbol>lock</symbol></li>
						<li><symbol>loc</symbol></li>
						<li><symbol>tie</symbol></li>
					</suffixSymbols>
				</symbolPack>
				<biostatCpx>0</biostatCpx>
				<displayCategory>Cosmetic</displayCategory>
				<iconColor>(0.75, 0.75, 0.75)</iconColor>
				<exclusionTags>
					<li>HairStyle</li>
				</exclusionTags>
			</GeneDef>
	<!-- GHOUL GENES -->
		<!-- WITHOUT PAIN -->
			<GeneDef ParentName="GenePainBase">
				<defName>WithoutPain</defName>
				<label>without pain</label>
				<labelShortAdj>archite-metabolic</labelShortAdj>
				<description>Carriers of this gene cannot experience pain. There is a good side to this and a bad side.</description>
				<iconPath>Modules/Genes/UI/GeneIcons/Gene_WithoutPain</iconPath>
				<displayCategory>GhoulGenes</displayCategory>
				<displayOrderInCategory>0</displayOrderInCategory>
				<marketValueFactor>1.5</marketValueFactor>
				<painFactor>0</painFactor>
				<biostatCpx>3</biostatCpx>
				<biostatMet>0</biostatMet>
				<biostatArc>1</biostatArc>
			</GeneDef>
		<!-- REGENERATION -->
			<GeneDef ParentName="GeneHealingRateBase">
				<defName>WoundHealing_Regeneration</defName>
				<label>regeneration</label>
				<labelShortAdj>regenaration-heal</labelShortAdj>
				<description>Carriers of this gene have extremely rapid wound healing.</description>
				<iconPath>Modules/Genes/UI/GeneIcons/Gene_WoundHealing_Regeneration</iconPath>
				<displayCategory>GhoulGenes</displayCategory>
				<displayOrderInCategory>1</displayOrderInCategory>
				<statFactors>
					<InjuryHealingFactor>30</InjuryHealingFactor>
				</statFactors>
				<biostatMet>-4</biostatMet>
				<symbolPack>
					<prefixSymbols>
						<li><symbol>stout</symbol></li>
						<li><symbol>hard</symbol></li>
					</prefixSymbols>
				</symbolPack>
				<biostatCpx>4</biostatCpx>
				<biostatMet>-2</biostatMet>
				<biostatArc>2</biostatArc>
			</GeneDef>
		<!-- GHOUL DEFORMITY -->
			<GeneDef ParentName="GeneBeautyBase">
				<defName>Beauty_Ghoul</defName>
				<label>ghoul deformity</label>
				<labelShortAdj>deformity</labelShortAdj>
				<description>Carriers of this gene look like a living corpse. No one wants to have a relationship with them except those of the same gene</description>
				<iconPath>Modules/Genes/UI/GeneIcons/Gene_Beauty_Ghoul</iconPath>
				<displayCategory>GhoulGenes</displayCategory>
				<displayOrderInCategory>3</displayOrderInCategory>
				<statOffsets>
					<PawnBeauty>-2</PawnBeauty>
				</statOffsets>
				<missingGeneRomanceChanceFactor>0</missingGeneRomanceChanceFactor>
				<biostatMet>3</biostatMet>
				<symbolPack>
					<prefixSymbols>
						<li>
							<symbol>gris</symbol>
						</li>
						<li>
							<symbol>hideo</symbol>
						</li>
						<li>
							<symbol>grote</symbol>
						</li>
						<li>
							<symbol>horri</symbol>
						</li>
						<li>
							<symbol>freak</symbol>
						</li>
						<li>
							<symbol>foul</symbol>
						</li>
						<li>
							<symbol>gross</symbol>
						</li>
					</prefixSymbols>
				</symbolPack>
			</GeneDef>
		<!-- AMENTIA -->
			<GeneDef>
				<defName>Amentia</defName>
				<label>Amentia</label>
				<labelShortAdj>amentia</labelShortAdj>
				<description>Carriers of this gene have critically low intelligence. This prevents them from doing some work properly.</description>
				<iconPath>Modules/Genes/UI/GeneIcons/Gene_Amentia</iconPath>
				<displayCategory>GhoulGenes</displayCategory>
				<displayOrderInCategory>2</displayOrderInCategory>
				<marketValueFactor>1.5</marketValueFactor>
				<disablesNeeds>
					<li>Beauty</li>
					<li>Outdoors</li>
				</disablesNeeds>
				<aptitudes>
					<Animals>-12</Animals>
					<Social>-12</Social>
					<Artistic>-12</Artistic>
					<Intellectual>-12</Intellectual>
					<Shooting>-12</Shooting>
					<Crafting>-12</Crafting>
				</aptitudes>
				<biostatCpx>2</biostatCpx>
				<biostatMet>+5</biostatMet>
			</GeneDef>
		<!-- GHOUL FACE -->
			<GeneDef>
				<defName>GhoulFace</defName>
				<label>ghoul face</label>
				<description>Carriers of this gene have a head like a ghoul.</description>
				<iconPath>Modules/Genes/UI/GeneIcons/Gene_Ghoulskin</iconPath>
				<displayCategory>GhoulGenes</displayCategory>
				<iconColor>(0.75, 0.75, 0.75)</iconColor>
				<displayOrderInCategory>500</displayOrderInCategory>
				<biostatCpx>0</biostatCpx>
				<renderNodeProperties>
					<li>
						<nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
						<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
						<parentTagDef>Head</parentTagDef>
						<colorType>Skin</colorType>
						<useRottenColor>true</useRottenColor>
						<useSkinShader>true</useSkinShader>
						<rotDrawMode>Fresh, Rotting</rotDrawMode>
						<texPaths>
							<li>Things/Pawn/Ghoul/Heads/GhoulskinHead_Heavy</li>
							<li>Things/Pawn/Ghoul/Heads/GhoulskinHead_Narrow</li>
							<li>Things/Pawn/Ghoul/Heads/GhoulskinHead_Normal</li>
							<li>Things/Pawn/Ghoul/Heads/GhoulskinHead_Wide</li>
						</texPaths>
						<visibleFacing>
							<li>East</li>
							<li>South</li>
							<li>West</li>
						</visibleFacing>
						<narrowCrownHorizontalOffset>0.03</narrowCrownHorizontalOffset>
						<baseLayer>51</baseLayer>
					</li>
				</renderNodeProperties>
			</GeneDef>
</Defs>