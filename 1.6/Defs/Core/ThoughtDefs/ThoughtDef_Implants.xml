	<!-- TMM_Thought_ -->


	<!-- IMPLANTS -->
		<!-- ADRENAL HEART -->
			<ThoughtDef>
				<defName>TMM_Thought_AdrenalHeartThoughts</defName>
				<workerClass>ThoughtWorker_Hediff</workerClass>
				<hediff>AdrenalHeart</hediff>
				<validWhileDespawned>true</validWhileDespawned>
				<developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
				<nullifyingTraits>
					<li>Transhumanist</li>
				</nullifyingTraits>
				<nullifyingHediffs>
					<li>Inhumanized</li>
				</nullifyingHediffs>
				<nullifyingPrecepts>
					<li MayRequire="Ludeon.RimWorld.Ideology">BodyMod_Approved</li>
				</nullifyingPrecepts>
				<stages>
					<li>
						<label>Installed Adrenal Heart</label>
						<description>A terrifying heart implanted in me! It invigorates me very much! Too much!</description>
						<baseMoodEffect>-6</baseMoodEffect>
					</li>
				</stages>
			</ThoughtDef>
		<!-- ARCHOTECH JOYWIRE -->
			<ThoughtDef>
				<defName>TMM_Thought_ArchotechJoywire</defName>
				<workerClass>ThoughtWorker_Hediff</workerClass>
				<hediff>TMM_Hediff_ArchotechJoywire</hediff>
				<validWhileDespawned>true</validWhileDespawned>
				<stages>
					<li>
						<label>Archotech joywire</label>
						<description>This... is living...</description>
						<baseMoodEffect>25</baseMoodEffect>
					</li>
				</stages>
			</ThoughtDef>
		<!-- CATHARSIS PROTOCOL -->
			<ThoughtDef>
				<defName>TMM_Thought_CatharsisImplant</defName>
				<workerClass>ThoughtWorker_Hediff</workerClass>
				<hediff>TMM_Hediff_CatharsisImplant</hediff>
				<validWhileDespawned>true</validWhileDespawned>
				<developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
				<stages>
					<li>
						<label>Catharsis Protocol</label>
						<description>Thanks to this implant, life just doesn't seem so bad, at all, ever.</description>
						<baseMoodEffect>30</baseMoodEffect>
					</li>
				</stages>
			</ThoughtDef>
		<!-- CORROSIVE HEART -->
			<ThoughtDef>
